PORT=3000
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_WEB_API_KEY=your-firebase-web-api-key
# Gmail SMTP sender for customer email verification. Keep these values backend-only.
SMTP_USER=
SMTP_PASSWORD=
# Generate a separate random secret of at least 32 bytes for OTP hashing.
REGISTRATION_OTP_PEPPER=
# Firebase Auth UID for the initial super admin. Its OWNER profile is created
# on first successful login if it is missing.
SUPER_ADMIN_UID=
# Use Application Default Credentials, GOOGLE_APPLICATION_CREDENTIALS, or the
# single-line JSON form below. Never commit service-account credentials.
# FIREBASE_SERVICE_ACCOUNT_JSON={"project_id":"...","client_email":"...","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n"}
WEB_ORIGIN=http://127.0.0.1:5173
# Exact browser origins allowed to call the API from Flutter Web.
CORS_ORIGINS=http://localhost:7357,http://127.0.0.1:7357
# Use HTTPS and COOKIE_SECURE=true when deploying behind an HTTPS proxy.
COOKIE_SECURE=false
# Pending handoffs expire automatically; allowed range: 60–1800 seconds.
VERIFICATION_TTL_SECONDS=600
# Current rentals are confirmed by an admin. Keep hardware endpoints on standby.
ENABLE_ESP32=false
# Pending review: 15 minutes. Approved before prep: 30 minutes. Prepared delivery: 2 hours.
# Each hold setting accepts 60–86400 seconds.
RENTAL_REQUEST_HOLD_SECONDS=900
RENTAL_PICKUP_HOLD_SECONDS=1800
RENTAL_DELIVERY_HOLD_SECONDS=7200
