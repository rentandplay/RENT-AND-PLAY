FROM node:22-slim

ENV NODE_ENV=production
WORKDIR /app

COPY apps/backend/package.json apps/backend/package-lock.json ./apps/backend/
RUN npm --prefix apps/backend ci --omit=dev

COPY apps/backend/src ./apps/backend/src
COPY apps/web ./apps/web
COPY apps/production-render.mjs ./apps/production-render.mjs

RUN npm --prefix apps/web run build

EXPOSE 10000
CMD ["node", "apps/production-render.mjs"]